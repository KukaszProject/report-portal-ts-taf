# ==========================================
# TEST ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Instructions: Copy this file, rename it to .env or .env.demo, 
# and fill in the required values before running tests.

# The base URL of the ReportPortal instance to test
BASE_URL=https://demo.reportportal.io

# Winston logger level (e.g., error, warn, info, debug)
LOG_LEVEL=info

# Default global timeout for Playwright operations (in milliseconds)
DEFAULT_TIMEOUT=30000

# ==========================================
# CREDENTIALS (DO NOT COMMIT REAL VALUES)
# ==========================================
# ADMIN_USERNAME=
# ADMIN_PASSWORD=